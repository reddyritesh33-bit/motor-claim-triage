# =============================================================================
# Runtime configuration. Copy to .env and fill in:   cp .env.example .env
# Nothing below is read from code defaults: credentials, endpoints and model
# identifiers are injected at runtime only (requirement D4). .env is gitignored.
# =============================================================================

# ---- LLM provider (read by llm-gateway only) --------------------------------
# stub               deterministic offline model, used for load tests (D6) and CI;
#                    the whole system runs end to end without any API key.
# openai_compatible  any OpenAI-compatible chat-completions endpoint. For the Groq
#                    free tier: LLM_BASE_URL = Groq's OpenAI-compatible base URL and
#                    LLM_MODEL = a model id from the Groq console (see README, "Using Groq").
LLM_PROVIDER=stub
LLM_API_KEY="<your-api-key>"
LLM_BASE_URL="<provider-openai-compatible-base-url>"
LLM_MODEL="<provider-model-id>"
LLM_TIMEOUT_S=20
LLM_MAX_RETRIES=3
LLM_BACKOFF_BASE_S=0.5
# list price in USD per 1M tokens, used to record cost at call time (L5).
# The free tier bills 0; list prices make cost-per-100-runs meaningful.
LLM_PRICE_INPUT_PER_1M_USD=0.59
LLM_PRICE_OUTPUT_PER_1M_USD=0.79
# stub latency per call (ms) - "a realistic delay"
STUB_DELAY_MS_MIN=800
STUB_DELAY_MS_MAX=1500
# circuit breaker on the provider
BREAKER_FAILURE_THRESHOLD=5
BREAKER_RESET_S=30

# ---- Embeddings (local, sentence-transformers; baked into the retriever image)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RETRIEVAL_MODE=hybrid
RETRIEVAL_CACHE_TTL_S=3600

# ---- Internal service endpoints (compose service names) ---------------------
REDIS_URL=redis://redis:6379/0
RETRIEVER_URL=http://retriever:8001
LLM_GATEWAY_URL=http://llm-gateway:8002
API_URL=http://api:8000

# ---- Tracing ---------------------------------------------------------------
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318

# ---- Agent loop bounds (A1) and verification --------------------------------
AGENT_MAX_STEPS=12
AGENT_MAX_TOOL_CALLS=10
AGENT_WALL_CLOCK_S=120
VERIFY_MAX_RETRIES=2
TOOL_TIMEOUT_S=10
LLM_CALL_TIMEOUT_S=75

# ---- Prompt versions (L2) -----------------------------------------------------
PROMPT_TRIAGE_VERSION=v1
PROMPT_COVERAGE_VERSION=v2
PROMPT_VERIFIER_VERSION=v1

# ---- Workers -----------------------------------------------------------------
WORKER_CONCURRENCY=4
JOB_LEASE_S=180
JOB_MAX_ATTEMPTS=2

# ---- API policy --------------------------------------------------------------
RATE_LIMIT_PER_MIN=30
RUN_CACHE_ENABLED=true
RUN_CACHE_TTL_S=3600
# allow X-Eval-Overrides (prompt variant / retrieval mode per request) - eval only
ALLOW_EVAL_OVERRIDES=true
# enable /admin/fault on the gateway and the X-Fault header (demo items 6 and 8)
FAULT_INJECTION_ENABLED=true
LIVE_EVAL_SAMPLE_RATE=0.2

# ---- Business thresholds -----------------------------------------------------
FAST_TRACK_MAX_ESTIMATE_INR=50000
CORPUS_PRODUCT_UIN=IRDAN134RP0004V03200708

# ---- Grafana admin (local only) ------------------------------------------------
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me

# 429 pacing: how many "slow down" replies to wait out per call, and the longest single wait
LLM_RATE_LIMIT_WAITS=6
LLM_RATE_LIMIT_MAX_WAIT_S=65

# characters of policy text sent to the model per coverage step (keeps prompts under provider limits)
AGENT_STATE_CHAR_BUDGET=14000

# JSON merged into every provider request for model-specific options, e.g. {"reasoning_effort":"low"}
LLM_EXTRA_BODY=
